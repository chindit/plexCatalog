{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-simplexml": "*",
        "chindit/plex-api": "^3.0",
        "guzzlehttp/guzzle": "^8.1.0",
        "intervention/image": "^4.3",
        "laravel/framework": "^13.29",
        "laravel/tinker": "^3.0",
        "spatie/browsershot": "^5.4"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.4",
        "fakerphp/faker": "^1.24.1",
        "laravel/sail": "^1.67.0",
        "mockery/mockery": "^1.6.15",
        "phpunit/phpunit": "^13.3.1",
        "spatie/laravel-ignition": "^2.12.0"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../plex-api",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "symfony/flex": true,
            "symfony/runtime": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
